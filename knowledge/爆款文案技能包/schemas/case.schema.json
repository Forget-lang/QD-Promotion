{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Viral Copy Case",
  "type": "object",
  "required": ["case_id", "title", "author", "likes", "comments", "script"],
  "properties": {
    "case_id":{"type":"string"},
    "title":{"type":"string"},
    "author":{"type":"string"},
    "likes":{"type":"integer","minimum":0},
    "comments":{"type":"integer","minimum":0},
    "publish_time":{"type":"string"},
    "tags":{"type":"array","items":{"type":"string"}},
    "description":{"type":"string"},
    "script":{"type":"string"},
    "domain":{"type":"string"},
    "content_form":{"type":"string"},
    "target_audience":{"type":"array","items":{"type":"string"}},
    "core_problem":{"type":"array","items":{"type":"string"}},
    "core_promise":{"type":"string"},
    "hook_type":{"type":"array","items":{"type":"string"}},
    "emotion":{"type":"array","items":{"type":"string"}},
    "conflict":{"type":"array","items":{"type":"string"}},
    "structure":{"type":"array","items":{"type":"string"}},
    "retention_devices":{"type":"array","items":{"type":"string"}},
    "proof_devices":{"type":"array","items":{"type":"string"}},
    "cta_type":{"type":"array","items":{"type":"string"}},
    "golden_lines":{"type":"array","items":{"type":"string"}},
    "strengths":{"type":"array","items":{"type":"string"}},
    "weaknesses":{"type":"array","items":{"type":"string"}},
    "copy_mechanisms":{"type":"array","items":{"type":"string"}},
    "originality_risk":{"type":"number","minimum":0,"maximum":100}
  }
}
