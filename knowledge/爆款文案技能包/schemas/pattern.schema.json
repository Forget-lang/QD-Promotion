{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Viral Pattern",
  "type": "object",
  "required": ["pattern_id", "name", "layer", "formula", "confidence"],
  "properties": {
    "pattern_id":{"type":"string"},
    "name":{"type":"string"},
    "layer":{"enum":["cross_domain","domain","format","creator"]},
    "formula":{"type":"string"},
    "psychology":{"type":"string"},
    "use_when":{"type":"array","items":{"type":"string"}},
    "avoid_when":{"type":"array","items":{"type":"string"}},
    "support_cases":{"type":"array","items":{"type":"string"}},
    "support_count":{"type":"integer","minimum":0},
    "median_likes":{"type":"number"},
    "baseline_likes":{"type":"number"},
    "lift":{"type":"number"},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "risk":{"type":"number","minimum":0,"maximum":1},
    "status":{"enum":["candidate","validated","strong","weakened","retired"]}
  }
}
