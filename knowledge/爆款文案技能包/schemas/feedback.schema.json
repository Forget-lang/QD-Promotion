{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Viral Copy Feedback",
  "type": "object",
  "required": ["content_id", "predicted_score", "views", "likes", "comments"],
  "properties": {
    "content_id":{"type":"string"},
    "topic":{"type":"string"},
    "hook_pattern":{"type":"array","items":{"type":"string"}},
    "structure_pattern":{"type":"array","items":{"type":"string"}},
    "emotion_pattern":{"type":"array","items":{"type":"string"}},
    "predicted_score":{"type":"number"},
    "views":{"type":"integer","minimum":0},
    "3s_retention":{"type":["number","null"]},
    "completion_rate":{"type":["number","null"]},
    "likes":{"type":"integer","minimum":0},
    "comments":{"type":"integer","minimum":0},
    "saves":{"type":"integer","minimum":0},
    "shares":{"type":"integer","minimum":0},
    "follows":{"type":"integer","minimum":0},
    "publish_context":{"type":"object"},
    "notes":{"type":"string"}
  }
}
