# 火山引擎 豆包 TTS 鉴权（请勿提交真实值；本文件为模板，供另一台电脑配置）
# 用法：TTS 调用脚本通过 os.environ["VOLC_TTS_API_KEY"] 读取
# 配置方法：复制本文件为 .env 并填入真实值
VOLC_TTS_API_KEY=

# 品牌音色与模型版本（非密钥，TTS 脚本读取）
# 主推音色：Vivi 2.0 青年（zh_female_vv_uranus_bigtts）——活泼灵动、有分享感，
#       抖音宣传片主推。后缀 uranus 为 2.0 大模型音色（jupiter 为 1.0，调不了）。
SPEAKER_ID=
# resource: 豆包语音合成 2.0（大模型语音合成，效果好、计费清晰）
RESOURCE_ID=
