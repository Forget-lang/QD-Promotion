{
  "description": "权威文档注册表：check-doc-references / check-facts 读取本文件。维护规则：新增权威文档时在此登记；文档清单变化时更新 aliases；关键计数（玩法/卖点/布局/手法等）变化时同步更新 counts。",
  "docsDir": "docs/internal",
  "extraDocs": [
    "AGENTS.md",
    "docs/战略简报.md",
    "docs/AI使用手册.md",
    "workflow/pipeline.md",
    "workflow/craft.md",
    "workflow/策划弹药库.md",
    "workflow/发布弹药库.md"
  ],
  "excludeDirs": [],
  "aliases": {
    "AGENTS": "AGENTS.md",
    "R2": "R2-业务流程.md",
    "R3": "R3-Remotion技术参考.md",
    "pipeline": "workflow/pipeline.md",
