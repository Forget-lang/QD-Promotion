    "策划弹药库": "workflow/策划弹药库.md",
    "发布弹药库": "workflow/发布弹药库.md"
  },
  "counts": [
    {
      "name": "玩法库条目",
      "source": { "file": "workflow/策划弹药库.md", "from": "### 1.1", "to": "### 1.2", "regex": "^\\| P-\\d+ \\|" },
      "claims": [
        { "label": "玩法编号段", "regex": "P-01~P-(\\d+)" }
      ],
      "stale": ["P-01~P-07", "P-01~07", "7 套通用玩法", "7套通用玩法", "七大玩法", "§1.9 矩阵", "1.9 矩阵"]
    },
    {
      "name": "特色卖点条目",
      "source": { "file": "workflow/策划弹药库.md", "regex": "^#### 卖点 \\d+" },
      "claims": [
        { "label": "卖点计数", "regex": "(\\d+)\\s*大(?:特色)?卖点" }
      ],
      "stale": ["十大卖点", "10 大卖点", "10大卖点", "10 大特色卖点"]
    },
    {
      "name": "布局模式条目",
      "source": { "file": "workflow/craft.md", "from": "## 8.", "to": "## 9.", "regex": "^\\| L-\\d{2} \\|" },
      "claims": [
        { "label": "布局模式段", "regex": "L-01~L-(\\d+)" },
        { "label": "布局模式种数", "regex": "布局模式库 (\\d+) 种" }
      ],
      "stale": []
    },
    {
      "name": "呈现手法条目",
      "source": { "file": "docs/internal/R3-Remotion技术参考.md", "from": "### 5.6", "to": "## 六", "regex": "^\\| \\*\\*" },
      "claims": [
        { "label": "手法选 1 计数", "regex": "(\\d+) 选 1" },
        { "label": "手法个数", "regex": "（(\\d+) 手法" }
      ],
      "stale": []
    },
    {
      "name": "钩子样式分支",
      "source": { "file": "video/src/scenes/HookScene.tsx", "regex": "hookStyle === '" },
      "claims": [
        { "label": "钩子样式种数", "regex": "已实现 (\\d+) 种选 1" }
      ],
      "stale": ["已实现 4 种选 1"]
    }
  ],
