# ============ 密钥 / 本地环境变量（禁止提交） ============
.env
.env.local
.env.*.local

# ============ 独立 git 仓库（applet 有专属 git，不套进本仓库） ============

# ============ 依赖与构建产物 ============
node_modules/
video/node_modules/

# 风格包引擎的 Python 隔离环境（不入库）
.venv/
__pycache__/
*.pyc

# macOS 系统垃圾
.DS_Store
Thumbs.db

# IDE 配置（本机特有，不入库）
.idea/
.vscode/

# ============ Remotion 缓存 / 渲染产物（源码可复现，不入库） ============
video/.cache/
**/_preview/

# ============ 过程产物/临时 ============
.doc-audit-cache/
.tmp/

# ============ 素材库（仅本地保留，不入库） ============
截图素材/
图标素材/
# 渲染语法错误可能产生的 frame:* 垃圾输出（防再入库）
video/frame:*
